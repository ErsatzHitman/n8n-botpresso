# URL of the n8n instance. Used by Vite's dev server proxy (not bundled into browser code).
N8N_URL=http://localhost:5678

# Webhook path to call. Switch between test and production depending on workflow state:
#   - Use /webhook-test/... when the workflow is open in n8n but NOT activated (test/listen mode)
#   - Use /webhook/...      when the workflow is activated (production toggle is ON)
VITE_WEBHOOK_PATH=/webhook/seo-metadata-agent
# VITE_WEBHOOK_PATH=/webhook-test/seo-metadata-agent

# For production builds (no Vite proxy): set this to your full n8n URL.
# VITE_API_URL=https://n8n.example.com
